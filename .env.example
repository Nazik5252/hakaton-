# ===== MTS Беларусь / Виртуальная АТС =====
# Эти значения берутся в личном кабинете ВАТС.
# Backend уже умеет принимать события МТС на /api/mts/callback.
MTS_VATS_BASE_URL=
MTS_VATS_API_KEY=

# Необязательная защита callback. Придумайте длинную строку.
# Тогда публичный callback можно указать как:
# https://YOUR-DOMAIN/api/mts/callback?secret=ЭТА_СТРОКА
MTS_CALLBACK_SECRET=change-me-please

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Server =====
PORT=3000
HOST=0.0.0.0
